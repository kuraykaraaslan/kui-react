{
  "name": "@kuraykaraaslan/kui-react",
  "version": "1.0.1",
  "description": "KUI React — atoms, molecules, organisms and common domain components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.mjs",
      "require": "./dist/app.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.mjs",
      "require": "./dist/common.js"
    },
    "./styles": "./styles/index.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "./styles/index.css"
  ],
  "scripts": {
    "dev": "next dev --port 3002",
    "parity:open": "node scripts/parity-open.mjs",
    "new:component": "node scripts/new-component.mjs",
    "predev": "node scripts/sync-kui-viewer-assets.mjs",
    "kui-viewer:assets": "node scripts/sync-kui-viewer-assets.mjs",
    "prebuild": "npm run kui-viewer:assets && npm run registry:snapshot",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start",
    "lint": "eslint",
    "screenshots": "node scripts/take-screenshots.js",
    "registry:snapshot": "node scripts/build-registry-snapshot.mjs",
    "mcp:server": "node scripts/mcp-server.mjs",
    "prepare": "husky && npm run build:lib",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:spacing": "node scripts/audit-spacing.mjs",
    "audit:conventions": "node scripts/audit-conventions.mjs",
    "debt:check": "node scripts/debt-ratchet.mjs",
    "check:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json modules libs",
    "check:cross-vertical": "node scripts/check-cross-vertical-imports.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": ">=7",
    "@fortawesome/free-brands-svg-icons": ">=7",
    "@fortawesome/free-regular-svg-icons": ">=7",
    "@fortawesome/free-solid-svg-icons": ">=7",
    "@fortawesome/react-fontawesome": ">=3",
    "next": "^14 || ^15 || ^16",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react-chartjs-2": {
      "optional": true
    },
    "quill": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "zustand": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": ">=7",
    "@fortawesome/free-brands-svg-icons": ">=7",
    "@fortawesome/free-regular-svg-icons": ">=7",
    "@fortawesome/free-solid-svg-icons": ">=7",
    "@fortawesome/react-fontawesome": ">=3",
    "@kuraykaraaslan/kui-viewer": "^0.3.32",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.4.1",
    "country-flag-icons": "^1.6.20",
    "iso-639-1": "^3.1.6",
    "leaflet": "^1.9.4",
    "quill": "^2.0.3",
    "react-chartjs-2": "^5.3.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hookform/resolvers": "^5.9.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "madge": "^8.0.0",
    "next": "16.3.6",
    "puppeteer": "^25.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraykaraaslan/kui-react.git"
  },
  "homepage": "https://next-js-components.kuray.dev",
  "bugs": {
    "url": "https://github.com/kuraykaraaslan/kui-react/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "design-system",
    "component-library",
    "ui-kit"
  ],
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    },
    "esbuild": "^0.28.2"
  }
}
