{
  "name": "@kuraykaraaslan/kui-react",
  "version": "1.0.1",
  "description": "KUI React — atoms, molecules, organisms and common domain components",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.mjs",
      "require": "./dist/app.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "import": "./dist/common.mjs",
      "require": "./dist/common.js"
    },
    "./styles": "./styles/index.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "sideEffects": [
    "./styles/index.css"
  ],
  "scripts": {
    "dev": "next dev --port 3002",
    "predev": "node scripts/sync-kui-viewer-assets.mjs",
    "kui-viewer:assets": "node scripts/sync-kui-viewer-assets.mjs",
    "prebuild": "npm run kui-viewer:assets && npm run registry:snapshot",
    "build": "next build",
    "build:lib": "tsup",
    "start": "next start",
    "lint": "eslint",
    "screenshots": "node scripts/take-screenshots.js",
    "registry:snapshot": "node scripts/build-registry-snapshot.mjs",
    "mcp:server": "node scripts/mcp-server.mjs",
    "prepare": "husky && npm run build:lib",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:spacing": "node scripts/audit-spacing.mjs",
    "audit:conventions": "node scripts/audit-conventions.mjs",
    "debt:check": "node scripts/debt-ratchet.mjs",
    "check:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json modules libs",
    "check:cross-vertical": "node scripts/check-cross-vertical-imports.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": ">=7",
    "@fortawesome/free-brands-svg-icons": ">=7",
    "@fortawesome/free-regular-svg-icons": ">=7",
    "@fortawesome/free-solid-svg-icons": ">=7",
    "@fortawesome/react-fontawesome": ">=3",
    "next": "^14 || ^15 || ^16",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react-chartjs-2": {
      "optional": true
    },
    "quill": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    },
    "zustand": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": ">=7",
    "@fortawesome/free-brands-svg-icons": ">=7",
    "@fortawesome/free-regular-svg-icons": ">=7",
    "@fortawesome/free-solid-svg-icons": ">=7",
    "@fortawesome/react-fontawesome": ">=3",
    "@kuraykaraaslan/kui-viewer": "^0.0.8",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "countries-list": "^3.3.0",
    "country-flag-icons": "^1.6.16",
    "iso-639-1": "^3.1.5",
    "leaflet": "^1.9.4",
    "quill": "^2.0.3",
    "react-chartjs-2": "^5.3.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@axe-core/react": "^4.11.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "madge": "^8.0.0",
    "next": "16.2.4",
    "puppeteer": "^24.43.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuraykaraaslan/kui-react.git"
  },
  "homepage": "https://next-js-components.kuray.dev",
  "bugs": {
    "url": "https://github.com/kuraykaraaslan/kui-react/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react",
    "nextjs",
    "tailwindcss",
    "design-system",
    "component-library",
    "ui-kit"
  ]
}
